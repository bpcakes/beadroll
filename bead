    cmd = add("dep", cmd_dep, "dependencies: dep add A B [--type blocks|parent-child], dep remove A B, dep list ID, dep tree ID, dep cycles")
    cmd.add_argument("words", nargs="*")
    cmd.add_argument("--type")
